{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RCD VlogCutter",
  "version": "0.1.0",
  "identifier": "com.rcd.vlogcutter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RCD VlogCutter",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/cache/**", "$HOME/**", "/Volumes/**", "/private/tmp/rcdvlog-*/cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
