#!/usr/bin/env node

import { readFile } from "node:fs/promises";
import { resolveAddress } from "./lib/eval-bridge.mjs";

const forwardedArgs = process.argv.slice(2);
const args = forwardedArgs[0] === "--" ? forwardedArgs.slice(1) : forwardedArgs;

function usage() {
  console.error(
    "Usage: rcdvlog-eval [--port <port>] [--wait <seconds>] '<javascript>'\n" +
      "       rcdvlog-eval [--port <port>] [--wait <seconds>] --file <path>",
  );
  process.exit(2);
}

// Connection options come first so the script itself can be any shape.
let port;
let waitMs = 0;
while (args[0] === "--port" || args[0] === "--wait") {
  const [flag, value] = args.splice(0, 2);
  if (value === undefined) usage();
  const parsed = Number(value);
  if (flag === "--port") {
    if (!Number.isInteger(parsed) || parsed < 1 || parsed > 65_535) usage();
    port = parsed;
  } else {
    if (!Number.isFinite(parsed) || parsed < 0) usage();
    waitMs = parsed * 1000;
  }
}

let script;
if (args[0] === "--file") {
  if (args.length !== 2) usage();
  try {
    script = await readFile(args[1], "utf8");
  } catch (error) {
    console.error(`Could not read ${args[1]}: ${error.message}`);
    process.exit(2);
  }
} else {
  if (args.length !== 1) usage();
  script = args[0];
}

let address;
try {
  ({ address } = await resolveAddress({ port, waitMs }));
} catch (error) {
  console.error(error.message);
  process.exit(1);
}

const socket = new WebSocket(address);
let settled = false;
const timer = setTimeout(() => {
  if (settled) return;
  settled = true;
  console.error(`Timed out waiting for the eval bridge at ${address}`);
  socket.close();
  process.exitCode = 1;
}, 35_000);

socket.addEventListener("open", () => socket.send(script));
socket.addEventListener("message", (event) => {
  if (settled) return;
  settled = true;
  clearTimeout(timer);
  const response = String(event.data);
  console.log(response);
  try {
    if (JSON.parse(response)?.error) process.exitCode = 1;
  } catch {
    process.exitCode = 1;
  }
  socket.close();
});
socket.addEventListener("error", () => {
  if (settled) return;
  settled = true;
  clearTimeout(timer);
  console.error(
    `Could not connect to ${address}. Start the desktop app with RCDVLOG_EVAL_BRIDGE=1.`,
  );
  process.exitCode = 1;
});
