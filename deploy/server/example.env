# Copy to deploy/server/.env and adjust these existing host directories.
# Compose uses create_host_path=false so a typo cannot silently create a mount.
RCDVLOG_DERIVED_HOST_PATH=/srv/rcdvlog/derived
RCDVLOG_BACKUP_HOST_PATH=/srv/rcdvlog/backups
RCDVLOG_ORIGINALS_HOST_PATH=/mnt/rcdvlog/originals

# Runtime and security tuning. The raw HTTP listener remains fixed to host loopback.
RCDVLOG_LAN_HOSTNAME=rcdvlog.local
RCDVLOG_SHUTDOWN_TIMEOUT_SECONDS=10
RCDVLOG_BACKUP_INTERVAL_SECONDS=86400
RCDVLOG_BACKUP_DAILY_RETENTION=14
RCDVLOG_BACKUP_WEEKLY_RETENTION=8
RCDVLOG_MINIMUM_FREE_BYTES=5368709120
RUST_LOG=info
